adxLen = input.int(14, "ADX Länge", minval = 2, group = "Trend-Tabelle", inline = "x")
adxSw  = input.int(20, "konsolidiert unter", minval = 5, maxval = 40, group = "Trend-Tabelle", inline = "x")
strLen = input.int(3, "Struktur: Swing-Länge (Kerzen)", minval = 1, maxval = 10, group = "Trend-Tabelle", tooltip = "Swing-Punkte aus Kerzenkörpern (Dochte zählen nicht). BOS erst bei Schlusskurs über/unter dem Swing")

// ── EMA-Cloud je TF: 1 = Long, -1 = Short, 0 = Ausbruch gegen die Cloud (Pfeil zeigt Richtung)
cloud(tf) =>
    [ef, es, c] = request.security(syminfo.tickerid, tf, [ta.ema(close, emaF), ta.ema(close, emaS), close])
    oben  = math.max(ef, es)
    unten = math.min(ef, es)
    up    = ef > es
    st    = up ? (c < unten ? 0 : 1) : (c > oben ? 0 : -1)
    pf    = st == 0 ? (up ? "↓" : "↑") : ""
    [st, pf]

[sD, pD]   = cloud("D")
[s4, p4]   = cloud("240")
[s1, p1]   = cloud("60")
[s15, p15] = cloud("15")
[s5, p5]   = cloud("5")

// ── ADX (Trendstärke) + Marktstruktur je TF ─────────────────
// Struktur: Swings aus Kerzenkörpern (Dochte zählen nicht) · BOS erst wenn der Schlusskurs den Swing bricht · 1 = bullish, -1 = bearish
strCalc() =>
    [pdi, mdi, adx] = ta.dmi(adxLen, adxLen)
    ph = ta.pivothigh(math.max(open, close), strLen, strLen)
    pl = ta.pivotlow(math.min(open, close), strLen, strLen)
    var float sH = na
    var float sL = na
    var int d = 0
    if not na(ph)
        sH := ph
    if not na(pl)
        sL := pl
    if not na(sH) and close > sH
        d := 1
        sH := na
    if not na(sL) and close < sL
        d := -1
        sL := na
    [adx, adx[1], d]

tfExtra(tf) =>
    request.security(syminfo.tickerid, tf, strCalc())

[aD, aD1, dD]       = tfExtra("D")
[a4, a41, d4]       = tfExtra("240")
[a1h, a1h1, d1]     = tfExtra("60")
[a15, a151, d15]    = tfExtra("15")
[a5, a51, d5]       = tfExtra("5")

// ── Volumen-Profil: Berechnung (wie FRVP: feste Ticks pro Zeile, Volumen einer Kerze gleichmäßig über High–Low verteilt) ──
// Auswertung eines fertigen Profils → POC, VAH, VAL, HVN-Liste ("31250,31355")
vpAuswerten(map<int, float> acc, float bs, float vaPct, int sens, int hvnMax) =>
    ks  = acc.keys()
    lo  = int(ks.min())
    n   = int(ks.max()) - lo + 1
    vol = array.new<float>(n, 0.0)
    for kk in ks
        vol.set(kk - lo, acc.get(kk))
    maxV = vol.max()
    pIdx = vol.indexof(maxV)
    // Value Area: ab POC jeweils zur volumenstärkeren Seite erweitern, bis X % erreicht sind
    ziel = vol.sum() * vaPct / 100.0
    vaV  = maxV
    up   = pIdx
    dn   = pIdx
    while vaV < ziel and (up < n - 1 or dn > 0)
        uV = up < n - 1 ? vol.get(up + 1) : -1.0
        dV = dn > 0 ? vol.get(dn - 1) : -1.0
        if uV >= dV
            up += 1
            vaV += uV
        else
            dn -= 1
            vaV += dV
    // HVN = Berge: Profil leicht glätten (±2 Zeilen), dann lokale Spitzen im Fenster ±span suchen
    sm = array.new<float>(n, 0.0)
    for i = 0 to n - 1
        s = 0.0
        c = 0
        for j = math.max(0, i - 2) to math.min(n - 1, i + 2)
            s += vol.get(j)
            c += 1
        sm.set(i, s / c)
    smMax = sm.max()
    span  = math.max(2, int(math.round(n * (11 - sens) * 0.01)))   // Empfindl. 10 → 1 % der Höhe, 1 → 10 %
    minV  = smMax * (11 - sens) * 0.03                             // Empfindl. 10 → ab 3 % vom POC, 1 → ab 30 %
    hIdx  = array.new<int>()
    hVol  = array.new<float>()
    for i = 0 to n - 1
        v = sm.get(i)
        if v >= minV and math.abs(i - pIdx) > span
            berg = true
            for j = math.max(0, i - span) to math.min(n - 1, i + span)
                if j != i and (sm.get(j) > v or (j < i and sm.get(j) == v))
                    berg := false
                    break
            if berg
                hIdx.push(i)
                hVol.push(v)
    // stärkste Berge zuerst, höchstens hvnMax
    string hvn = ""
    int cnt = 0
    while hVol.size() > 0 and cnt < hvnMax
        m = hVol.indexof(hVol.max())
        hvn += (cnt > 0 ? "," : "") + str.tostring((lo + hIdx.get(m) + 0.5) * bs, "#.##")
        hVol.remove(m)
        hIdx.remove(m)
        cnt += 1
    [(lo + pIdx + 0.5) * bs, (lo + up + 1) * bs, (lo + dn) * bs, hvn]

// Sammelt Volumen pro Periode (läuft im Daten-Zeitrahmen). modus: 0 = Tag (Session), 1 = Woche, 2 = Monat
// Liefert immer das zuletzt ABGESCHLOSSENE Profil (Vortag / Vorwoche / Vormonat) + ob es vollständig geladen war
vpCalc(bool aktiv, int modus, int rowT, float vaPct, int sens, int hvnMax, string sess, int wEndMin) =>
    var map<int, float> acc = map.new<int, float>()
    var int    pKey  = na
    var bool   voll  = false
    var float  rPoc  = na
    var float  rVah  = na
    var float  rVal  = na
    var string rHvn  = ""
    var bool   rVoll = false
    inSes = not na(time(timeframe.period, sess, "Europe/Berlin"))
    if aktiv
        bs    = rowT * syminfo.mintick
        y     = year(time, "Europe/Berlin")
        mo    = month(time, "Europe/Berlin")
        wOff  = (dayofweek(time, "Europe/Berlin") + 5) % 7     // Mo = 0 … So = 6
        tagNr = int(math.floor(timestamp("UTC", y, mo, dayofmonth(time, "Europe/Berlin")) / 86400000))
        k     = modus == 0 ? tagNr : modus == 1 ? tagNr - wOff : y * 12 + mo
        if na(pKey) or k != pKey
            if acc.size() > 0
                [a, b, c, h] = vpAuswerten(acc, bs, vaPct, sens, hvnMax)
                rPoc  := a
                rVah  := b
                rVal  := c
                rHvn  := h
                rVoll := voll
            acc.clear()
            voll := not na(pKey)    // erste Periode im Chart ist meist nur halb geladen
            pKey := k
        wMin = wOff * 1440 + hour(time, "Europe/Berlin") * 60 + minute(time, "Europe/Berlin")
        drin = modus == 0 ? inSes : modus == 1 ? wMin < wEndMin : true
        if drin and volume > 0
            b0 = int(math.floor(low / bs))
            b1 = int(math.floor(high / bs))
            ve = volume / (b1 - b0 + 1)
            for b = b0 to b1
                acc.put(b, nz(acc.get(b)) + ve)
    [rPoc, rVah, rVal, rHvn, rVoll]

vpAuto = vpQuelle == "Automatisch"
wEnde  = vpWoEnde == "Fr 00:00" ? 4 * 1440 : vpWoEnde == "Fr 22:00" ? 4 * 1440 + 1320 : 5 * 1440
[tPoc, tVah, tVal, tHvn, tVoll] = request.security(syminfo.tickerid, pT_tf, vpCalc(vpAuto and pT_an, 0, pT_row, pT_va, pT_sen, pT_max, pT_ses, wEnde))
[wPoc, wVah, wVal, wHvn, wVoll] = request.security(syminfo.tickerid, pW_tf, vpCalc(vpAuto and pW_an, 1, pW_row, pW_va, pW_sen, pW_max, pT_ses, wEnde))
[mPoc, mVah, mVal, mHvn, mVoll] = request.security(syminfo.tickerid, pM_tf, vpCalc(vpAuto and pM_an, 2, pM_row, pM_va, pM_sen, pM_max, pT_ses, wEnde))

// Darstellung je Bereich (Tag / Woche / Monat)
type VPStil
    bool   an
    bool   va
    bool   poc
    bool   hvn
    color  cVA
    color  cPOC
    color  cHVN
    string sVA
    string sPOC
    string sHVN
    int    wVA
    int    wPOC
    int    wHVN
    string kz

// ── VWAP Tag / Woche / Monat + Sessions ────────────────────
deH   = hour(time, "Europe/Berlin")
deMin = deH * 60 + minute(time, "Europe/Berlin")
deTag = dayofmonth(time, "Europe/Berlin")
var int tagStart = 0
if deTag != deTag[1]
    tagStart := bar_index
neuT  = vwStart == "14:00" ? (deMin >= 840 and (deMin[1] < 840 or deTag != deTag[1])) : deTag != deTag[1]
vwT0  = ta.vwap(hlc3, neuT)
vwT   = vwStart == "14:00" and deMin < 840 ? na : vwT0
vwW   = ta.vwap(hlc3, timeframe.change("W"))
vwM   = ta.vwap(hlc3, timeframe.change("M"))

// Kein senkrechter Strich beim Neustart (erste Kerze der neuen Periode bleibt leer)
// Session-VWAP: läuft ab Session-Start mit, außerhalb der Session keine Linie
sesVW(sess) =>
    inS = not na(time(timeframe.period, sess, "Europe/Berlin"))
    v   = ta.vwap(hlc3, inS and not inS[1])
    inS ? v : na

vwAsia = sesVW(sAsia)
vwLon  = sesVW(sLon)
vwNY   = sesVW(sNY)

plot(vT_on and not neuT ? vwT : na, "VWAP Tag", color = vT_c, linewidth = vT_w, style = plot.style_linebr)
plot(vW_on and not timeframe.change("W") ? vwW : na, "VWAP Woche", color = vW_c, linewidth = vW_w, style = plot.style_linebr)
plot(vM_on and not timeframe.change("M") ? vwM : na, "VWAP Monat", color = vM_c, linewidth = vM_w, style = plot.style_linebr)
plot(vA_on ? vwAsia : na, "VWAP Asia", color = vA_c, linewidth = vA_w, style = plot.style_linebr)
plot(vL_on ? vwLon : na, "VWAP London", color = vL_c, linewidth = vL_w, style = plot.style_linebr)
plot(vN_on ? vwNY : na, "VWAP New York", color = vN_c, linewidth = vN_w, style = plot.style_linebr)

// ── Live-Faktor NQ/QQQ (nur US-Börsenzeit, 15-Min-Mittel, mit Mindest-Verschiebung)
qqqC  = request.security(qqqSym, timeframe.period, close, ignore_invalid_symbol = true)
usRTH = deMin >= 930 and deMin < 1320
var array<float> fBuf = array.new<float>()
var float fLive = fBase
if usRTH and not na(qqqC) and qqqC > 0
    fBuf.push(close / qqqC)
    if fBuf.size() > 15
        fBuf.shift()
    fNeu = fBuf.avg()
    if math.abs(fNeu - fLive) * close / fLive >= liveMin
        fLive := fNeu
else if not usRTH
    fBuf.clear()
liveP(preis) => liveOn ? math.round(preis / fBase) * fLive : preis

// Handelszeit (DE): 08:00–10:00 · 13:00–15:30 · 15:35–17:30 · 18:30–22:00
handel = (deMin >= 480 and deMin < 600) or (deMin >= 780 and deMin < 930) or (deMin >= 935 and deMin < 1050) or (deMin >= 1110 and deMin < 1320)

// ── Vertikale Linien: eine Linie bei jedem Start des gewählten Zeitrahmens ──
var array<line> vlLinien = array.new<line>()
vlChg = ta.change(time(vlTf))
if vlOn and timeframe.isintraday and timeframe.in_seconds(vlTf) >= timeframe.in_seconds() and vlChg != 0
    while vlLinien.size() >= vlAnz
        vlLinien.shift().delete()
    vlLinien.push(line.new(bar_index, low - ta.tr, bar_index, high + ta.tr, xloc.bar_index, extend.both, vlCol, vlStil == "gestrichelt" ? line.style_dashed : vlStil == "gepunktet" ? line.style_dotted : line.style_solid, vlBr))

// ── Zeichnen ───────────────────────────────────────────────
var float vahT = na
var float valT = na
var float vahW = na
var float valW = na

var array<line>  linien = array.new<line>()
var array<box>   boxen  = array.new<box>()
var array<label> labels = array.new<label>()
// OI-Zonen für das Live-Signal (Unter-/Obergrenze, Name)
var array<float>  zLo  = array.new<float>()
var array<float>  zHi  = array.new<float>()
var array<string> zNm  = array.new<string>()
// Volumen-Levels (Preis, Typ VAH/VAL/POC/HVN, Bereich 0 = Tag, 1 = Woche, 2 = Monat)
var array<float>  lvP   = array.new<float>()
var array<string> lvTyp = array.new<string>()
var array<int>    lvPer = array.new<int>()

aufraeumen() =>
    for l in linien
        l.delete()
    for b in boxen
        b.delete()
    for lb in labels
        lb.delete()
    linien.clear()
    boxen.clear()
    labels.clear()

stilVon(s) => s == "gestrichelt" ? line.style_dashed : s == "gepunktet" ? line.style_dotted : line.style_solid

// "21,1k" → 21100 · "466" → 466
kWert(t) =>
    x = str.replace_all(str.replace_all(str.trim(t), ",", "."), "k", "")
    v = str.tonumber(x)
    na(v) ? 0.0 : str.contains(t, "k") ? v * 1000 : v

// Summe Call + Put aus "21,1k - 466 (strong)"
oiSumme(info) =>
    teil = str.split(info, " - ")
    teil.size() > 1 ? kWert(teil.get(0)) + kWert(str.split(str.trim(teil.get(1)), " ").get(0)) : 0.0

x0() => zeichAb == "Heute" ? math.max(tagStart, bar_index - 4500) : bar_index - 1
ext() => zeichAb == "Heute" ? extend.right : extend.both

hLinie(y, col, w, stil) =>
    linien.push(line.new(x0(), y, bar_index, y, extend = ext(), color = col, width = w, style = stil))

// Linie mit Glow: mehrere breite, transparente Schichten (außen weich → innen kräftiger), darüber die eigentliche Linie
glowLinie(float y, color col, color gcol, int w, string stil, bool an) =>
    if an
        gc = glowEig ? glowCol : gcol
        for g = glowLag to 1
            tr = 100.0 - (100.0 - glowTr) * (glowLag - g + 1) / glowLag
            linien.push(line.new(x0(), y, bar_index, y, extend = ext(), color = color.new(gc, tr), width = w + g * glowBr))
    hLinie(y, col, w, stilVon(stil))

// Volumen-Labels rechtsbündig links neben den OI-Labels → nie übereinander
txtR(y, t, col) =>
    labels.push(label.new(bar_index + oiAbst - 1, y, t, style = label.style_label_right, color = color.new(color.white, 100), textcolor = col, size = txtGr))

// VWAP-Namen klein am Linienende
vwName(on, v, t, col) =>
    if on and not na(v)
        labels.push(label.new(bar_index + 1, v, t, style = label.style_label_left, color = color.new(color.white, 100), textcolor = col, size = size.tiny))

txt(x, y, t, col) =>
    labels.push(label.new(x, y, t, style = label.style_label_left, color = color.new(color.white, 100), textcolor = col, size = txtGr))

lvAdd(float p, string typ, int per) =>
    if not na(p)
        lvP.push(p)
        lvTyp.push(typ)
        lvPer.push(per)

lvAddProfil(float poc, float vah, float val, string hvn, int per) =>
    lvAdd(vah, "VAH", per)
    lvAdd(poc, "POC", per)
    lvAdd(val, "VAL", per)
    if hvn != ""
        for s in str.split(hvn, ",")
            lvAdd(str.tonumber(s), "HVN", per)

if barstate.islast
    aufraeumen()
    zLo.clear()
    zHi.clear()
    zNm.clear()
    halb = zoneTicks * syminfo.mintick / 2

    // OI-Zonen: zuerst stärkste Zone des Tages (höchste Summe Call + Put) suchen
    float maxSumme = 0.0
    for zeile in str.split(oiAlle, "\n")
        tz = str.split(zeile, "|")
        if tz.size() > 1
            maxSumme := math.max(maxSumme, oiSumme(tz.get(1)))
    for zeile in str.split(oiAlle, "\n")
        z = str.trim(zeile)
        if str.contains(z, ",")
            teile = str.split(z, "|")
            kopf  = str.split(str.trim(teile.get(0)), ",")
            preis0 = str.tonumber(str.trim(kopf.get(0)))
            if not na(preis0) and kopf.size() > 1
                name   = str.trim(kopf.get(1))
                preis  = str.startswith(name, "EM") ? preis0 : liveP(preis0)
                if str.startswith(name, "EM")
                    if emOn
                        hLinie(preis, cEM, 1, line.style_dashed)
                        txt(bar_index + oiAbst, preis, str.split(name, " ").get(0) + " Expected Move", cEM)
                    continue
                istDP  = str.startswith(name, "DP") or str.contains(str.lower(name), "doppel")
                istPut = not istDP and str.startswith(name, "P")
                info0  = teile.size() > 1 ? teile.get(1) : ""
                top    = maxSumme > 0 and oiSumme(info0) == maxSumme
                farbe  = istDP or top ? cDP : istPut ? cPut : cCall
                info   = teile.size() > 1 ? str.trim(teile.get(1)) : ""
                baseTr = istDP or top ? dpTr : zoneTr
                zLo.push(preis - halb)
                zHi.push(preis + halb)
                zNm.push(str.split(name, " ").get(0) + " " + str.tostring(preis, "#"))
                if zVerl
                    // Verlauf: gestapelte Boxen von außen nach innen → Mitte kräftig, Rand weich
                    trS = math.min(99.0, 100 - (100 - baseTr) * 1.5 / zVerlN)
                    for s = zVerlN to 1
                        hs = halb * s / zVerlN
                        boxen.push(box.new(x0(), preis + hs, bar_index, preis - hs, border_color = na, bgcolor = color.new(farbe, trS), extend = ext()))
                else
                    boxen.push(box.new(x0(), preis + halb, bar_index, preis - halb, border_color = na, bgcolor = color.new(farbe, baseTr), extend = ext()))
                glowLinie(preis, color.new(cMitte, mitteTr), farbe, mitteW, "durchgezogen", glowOI)
                txt(bar_index + oiAbst, preis, name + (oiInfo and info != "" ? " | " + info : ""), cText)

    // Volumen-Levels sammeln (automatisch berechnet oder aus dem Textblock)
    lvP.clear()
    lvTyp.clear()
    lvPer.clear()
    if vpAuto
        lvAddProfil(tPoc, tVah, tVal, tHvn, 0)
        lvAddProfil(wPoc, wVah, wVal, wHvn, 1)
        lvAddProfil(mPoc, mVah, mVal, mHvn, 2)
    else
        for zeile in str.split(volText, "\n")
            z = str.trim(zeile)
            if str.contains(z, ",")
                kopf  = str.split(str.trim(str.split(z, "|").get(0)), ",")
                preis = str.tonumber(str.trim(kopf.get(0)))
                if not na(preis) and kopf.size() > 1
                    name = str.trim(kopf.get(1))
                    per  = str.endswith(name, " M") ? 2 : str.endswith(name, " W") or str.contains(str.lower(name), "woche") ? 1 : 0
                    typ  = str.contains(name, "HVN") ? "HVN" : str.contains(name, "POC") ? "POC" : str.contains(name, "VAH") ? "VAH" : str.contains(name, "VAL") ? "VAL" : ""
                    if typ != ""
                        lvAdd(preis, typ, per)

    stile = array.from(VPStil.new(pT_an, pT_sVA, pT_sPC, pT_sHV, pT_cVA, pT_cPC, pT_cHV, pT_lVA, pT_lPC, pT_lHV, pT_wVA, pT_wPC, pT_wHV, "T"), VPStil.new(pW_an, pW_sVA, pW_sPC, pW_sHV, pW_cVA, pW_cPC, pW_cHV, pW_lVA, pW_lPC, pW_lHV, pW_wVA, pW_wPC, pW_wHV, "W"), VPStil.new(pM_an, pM_sVA, pM_sPC, pM_sHV, pM_cVA, pM_cPC, pM_cHV, pM_lVA, pM_lPC, pM_lHV, pM_wVA, pM_wPC, pM_wHV, "M"))

    vahT := na
    valT := na
    vahW := na
    valW := na
    if lvP.size() > 0
        for i = 0 to lvP.size() - 1
            per = lvPer.get(i)
            st  = stile.get(per)
            typ = lvTyp.get(i)
            p   = lvP.get(i)
            istHVN = typ == "HVN"
            istPOC = typ == "POC"
            if st.an
                if typ == "VAH"
                    vahT := per == 0 ? p : vahT
                    vahW := per == 1 ? p : vahW
                if typ == "VAL"
                    valT := per == 0 ? p : valT
                    valW := per == 1 ? p : valW
                if istHVN ? st.hvn : istPOC ? st.poc : st.va
                    col = istHVN ? st.cHVN : istPOC ? st.cPOC : st.cVA
                    glowLinie(p, col, col, istHVN ? st.wHVN : istPOC ? st.wPOC : st.wVA, istHVN ? st.sHVN : istPOC ? st.sPOC : st.sVA, glowVol)
                    txtR(p, typ + " " + st.kz + (vpPreis ? "  " + str.tostring(p, "#") : ""), col)

    // VWAP-Namen klein am Linienende
    vwName(vT_on, vwT, "VWAP T", vT_c)
    vwName(vW_on, vwW, "VWAP W", vW_c)
    vwName(vM_on, vwM, "VWAP M", vM_c)
    vwName(vA_on, vwAsia, "VWAP Asia", vA_c)
    vwName(vL_on, vwLon, "VWAP London", vL_c)
    vwName(vN_on, vwNY, "VWAP NY", vN_c)

    if vaBox == "Hintergrund"
        if not na(vahW) and not na(valW)
            boxen.push(box.new(x0(), vahW, bar_index, valW, border_color = na, bgcolor = color.new(cBoxW, boxTr), extend = ext()))
        if not na(vahT) and not na(valT)
            boxen.push(box.new(x0(), vahT, bar_index, valT, border_color = na, bgcolor = color.new(cBoxT, boxTr), extend = ext()))
    if vaBox == "Säule rechts"
        xT = bar_index + vaSAbst
        xW = xT + 2
        if not na(vahT) and not na(valT)
            linien.push(line.new(xT, vahT, xT, valT, color = color.new(cBoxT, vaSTr), width = vaSBr, style = stilVon(vaSStil)))
        if not na(vahW) and not na(valW)
            linien.push(line.new(xW, vahW, xW, valW, color = color.new(cBoxW, vaSTr), width = vaSBr, style = stilVon(vaSStil)))


// ── Orderblocks & Breakers (VEGAlgo, MPL 2.0) – Logik unverändert, nur an/aus + Anzeige am letzten Bar ──
type Orderblock
    box boxObj
    float top
    float bottom
    int startBar
    bool isBullish
    bool isBreaker
    bool wasOriginallyBullish

type PendingOB
    float level
    int obBar
    float obTop
    float obBottom
    bool isBullish
    int breachBar

isSwingHigh = ta.pivothigh(high, obSwing, obSwing)
isSwingLow  = ta.pivotlow(low, obSwing, obSwing)

var float lastSwingHigh = na
var float lastSwingLow = na
var int lastSwingHighBar = na
var int lastSwingLowBar = na
var bool swingHighBreached = false
var bool swingLowBreached = false
var array<Orderblock> orderblocks = array.new<Orderblock>()
var array<PendingOB> pendingOBs = array.new<PendingOB>()
bool atOrderblock = false
bool atBreaker = false

if obOn
    if not na(isSwingHigh)
        lastSwingHigh := isSwingHigh
        lastSwingHighBar := bar_index - obSwing
        swingHighBreached := false

    if not na(isSwingLow)
        lastSwingLow := isSwingLow
        lastSwingLowBar := bar_index - obSwing
        swingLowBreached := false

    highBreached = not na(lastSwingHigh) and not swingHighBreached and high > lastSwingHigh
    lowBreached = not na(lastSwingLow) and not swingLowBreached and low < lastSwingLow

    if highBreached
        swingHighBreached := true

    if lowBreached
        swingLowBreached := true

    // Letzte bärische Kerze vor dem Bruch merken
    if highBreached
        alreadyPending = false
        if array.size(pendingOBs) > 0
            for j = 0 to array.size(pendingOBs) - 1
                existingPending = array.get(pendingOBs, j)
                if existingPending.isBullish and math.abs(existingPending.level - lastSwingHigh) < 0.0001
                    alreadyPending := true
                    break

        if not alreadyPending
            for i = 1 to 50
                if bar_index - i <= lastSwingHighBar
                    break
                if close[i] < open[i]
                    pending = PendingOB.new(
                         level = lastSwingHigh,
                         obBar = bar_index - i,
                         obTop = high[i],
                         obBottom = low[i],
                         isBullish = true,
                         breachBar = bar_index
                     )
                    array.push(pendingOBs, pending)
                    break

    // Letzte bullische Kerze vor dem Bruch merken
    if lowBreached
        alreadyPending = false
        if array.size(pendingOBs) > 0
            for j = 0 to array.size(pendingOBs) - 1
                existingPending = array.get(pendingOBs, j)
                if not existingPending.isBullish and math.abs(existingPending.level - lastSwingLow) < 0.0001
                    alreadyPending := true
                    break

        if not alreadyPending
            for i = 1 to 50
                if bar_index - i <= lastSwingLowBar
                    break
                if close[i] > open[i]
                    pending = PendingOB.new(
                         level = lastSwingLow,
                         obBar = bar_index - i,
                         obTop = high[i],
                         obBottom = low[i],
                         isBullish = false,
                         breachBar = bar_index
                     )
                    array.push(pendingOBs, pending)
                    break

    // Pending-OBs per Schlusskurs bestätigen
    bullishMSB = not na(lastSwingHigh) and close > lastSwingHigh and close[1] <= lastSwingHigh
    bearishMSB = not na(lastSwingLow) and close < lastSwingLow and close[1] >= lastSwingLow

    if array.size(pendingOBs) > 0
        for i = array.size(pendingOBs) - 1 to 0
            pending = array.get(pendingOBs, i)

            if pending.isBullish and bullishMSB and math.abs(pending.level - lastSwingHigh) < 0.0001
                newBox = box.new(
                     left = pending.obBar,
                     top = pending.obTop,
                     right = bar_index + 50,
                     bottom = pending.obBottom,
                     border_color = cOBbullR,
                     bgcolor = cOBbullF,
                     border_width = 1,
                     extend = extend.right
                 )
                ob = Orderblock.new(newBox, pending.obTop, pending.obBottom, pending.obBar, true, false, true)
                array.push(orderblocks, ob)
                array.remove(pendingOBs, i)

            else if not pending.isBullish and bearishMSB and math.abs(pending.level - lastSwingLow) < 0.0001
                newBox = box.new(
                     left = pending.obBar,
                     top = pending.obTop,
                     right = bar_index + 50,
                     bottom = pending.obBottom,
                     border_color = cOBbearR,
                     bgcolor = cOBbearF,
                     border_width = 1,
                     extend = extend.right
                 )
                ob = Orderblock.new(newBox, pending.obTop, pending.obBottom, pending.obBar, false, false, false)
                array.push(orderblocks, ob)
                array.remove(pendingOBs, i)

    // Breaker + Chop-Kontrolle
    if array.size(orderblocks) > 0
        for i = array.size(orderblocks) - 1 to 0
            ob = array.get(orderblocks, i)

            if not ob.isBreaker
                if ob.isBullish and close < ob.bottom
                    ob.isBreaker := true
                    box.set_bgcolor(ob.boxObj, cBRbearF)
                    box.set_border_color(ob.boxObj, cBRbearR)
                    array.set(orderblocks, i, ob)

                if not ob.isBullish and close > ob.top
                    ob.isBreaker := true
                    box.set_bgcolor(ob.boxObj, cBRbullF)
                    box.set_border_color(ob.boxObj, cBRbullR)
                    array.set(orderblocks, i, ob)

            else if obChop and ob.isBreaker
                shouldRemove = false

                if ob.wasOriginallyBullish
                    if close > ob.top
                        shouldRemove := true
                else
                    if close < ob.bottom
                        shouldRemove := true

                if shouldRemove
                    box.delete(ob.boxObj)
                    array.remove(orderblocks, i)

    // Alarm-Zustände
    if array.size(orderblocks) > 0
        for ob in orderblocks
            if low <= ob.top and high >= ob.bottom
                if ob.isBreaker
                    atBreaker := true
                else
                    atOrderblock := true

// Anzeige (nur am letzten Bar nötig)
if obOn and barstate.islast and array.size(orderblocks) > 0
    int visibleCount = 0
    for i = array.size(orderblocks) - 1 to 0
        ob = array.get(orderblocks, i)
        shouldShow = true

        if not obShowOB and not ob.isBreaker
            shouldShow := false
        if not obShowBr and ob.isBreaker
            shouldShow := false
        if obRecentOn and visibleCount >= obRecent
            shouldShow := false

        if shouldShow
            box.set_bgcolor(ob.boxObj, ob.isBreaker ? (ob.wasOriginallyBullish ? cBRbearF : cBRbullF) : (ob.isBullish ? cOBbullF : cOBbearF))
            box.set_border_color(ob.boxObj, ob.isBreaker ? (ob.wasOriginallyBullish ? cBRbearR : cBRbullR) : (ob.isBullish ? cOBbullR : cOBbearR))
            box.set_right(ob.boxObj, bar_index + 50)
            visibleCount += 1
        else
            box.set_bgcolor(ob.boxObj, color.new(color.gray, 100))
            box.set_border_color(ob.boxObj, color.new(color.gray, 100))

alertcondition(atOrderblock, title = "Preis an Orderblock", message = "Preis berührt eine Orderblock-Zone")
alertcondition(atBreaker, title = "Preis an Breaker", message = "Preis berührt eine Breaker-Zone")
alertcondition(atOrderblock or atBreaker, title = "Preis an Orderblock oder Breaker", message = "Preis berührt eine Orderblock- oder Breaker-Zone")


// ── Trend-Tabelle ──────────────────────────────────────────
// Aufbau: Kopf (TF · Trend · ADX · Struktur) → Zeile je Zeitrahmen → Lage zu VA / VWAP → Setup-Banner → Checkliste → Signal → Volumen-Profil
farbeSt(st) => st == 1 ? tLong : st == -1 ? tShort : tNeut
vaSt(hi, lo) => na(hi) or na(lo) ? 2 : close > hi ? 1 : close < lo ? -1 : 0
vwSt(v) => na(v) ? 2 : close > v ? 1 : -1
stFarbe(s) => s == 2 ? tDunk : farbeSt(s)
// Long-Zelle weiß mit dunkelroter Schrift, Short-Zelle dunkelrot mit weißer Schrift
stSchrift(s) => s == 1 ? tShort : color.white
grGross = tGr == size.small ? size.normal : size.large

var bool gemerged = false
var table tb = table.new(tPos, 4, 34, frame_color = tRahm, frame_width = 3, border_color = tRahm, border_width = tRahB)

zelle(int c, int r, string t, color tc, color bg, string sz = size.normal, string ha = text.align_center, bool fett = false) =>
    table.cell(tb, c, r, t, text_color = tc, text_size = sz, bgcolor = bg, text_halign = ha, text_formatting = fett ? text.format_bold : text.format_none)

leer(int c, int r) =>
    table.cell(tb, c, r, "", bgcolor = color.new(color.white, 100))

// Zeile je Zeitrahmen: Name | Trend (EMA-Cloud, Pfeil = Ausbruch gegen die Cloud) | ADX-Zahl + Pfeil (– = konsolidiert) | Struktur (BOS)
tfZeile(r, name, s, pf, a, aV, sd) =>
    kons   = na(a) or a < adxSw
    steigt = not na(aV) and a > aV
    adxT   = na(a) ? "–" : str.tostring(a, "#") + (kons ? "  –" : steigt ? "  ↑" : "  ↓")
    zelle(0, r, name, color.white, tKopf, tGr, text.align_left)
    zelle(1, r, s == 2 ? "–" : s == 1 ? "LONG" : s == -1 ? "SHORT" : "neutral " + pf, stSchrift(s), stFarbe(s), tGr, text.align_center, true)
    zelle(2, r, adxT, kons ? color.new(color.white, 35) : color.white, kons ? tDunk : steigt ? color.new(#4a4d55, 0) : tDunk, tGr)
    zelle(3, r, sd == 1 ? "bullish ↑" : sd == -1 ? "bearish ↓" : "–", sd == 1 ? color.black : color.white, sd == 1 ? tLong : sd == -1 ? tShort : tDunk, tGr)

// Lage des Kurses zu Value Area / VWAP
lage(c, r, name, s) =>
    t = s == 1 ? "über" : s == -1 ? "unter" : s == 0 ? "innen" : "–"
    zelle(c, r, name + ":  " + t, s == 1 ? color.black : color.white, stFarbe(s), tGr, text.align_left)

profTxt(bool an, float poc, float vah, float val, string hvn, bool voll) =>
    hz = hvn == "" ? 0 : str.split(hvn, ",").size()
    not an ? "aus" : na(poc) ? "keine Daten – Historie zu kurz" : "VAH " + str.tostring(vah, "#") + " · POC " + str.tostring(poc, "#") + " · VAL " + str.tostring(val, "#") + " · " + str.tostring(hz) + " HVN" + (voll ? "" : "  ⚠ unvollständig")

if barstate.islast and tShow
    // Leerzeilen oben (Tabelle etwas tiefer)
    if tAbst > 0
        for r = 0 to tAbst - 1
            for c = 0 to 3
                leer(c, r)
    o = tAbst

    // Kopf
    zelle(0, o, "TF", color.new(color.white, 30), tKopf, size.small, text.align_left, true)
    zelle(1, o, "TREND", color.new(color.white, 30), tKopf, size.small, text.align_center, true)
    zelle(2, o, "ADX", color.new(color.white, 30), tKopf, size.small, text.align_center, true)
    zelle(3, o, "STRUKTUR", color.new(color.white, 30), tKopf, size.small, text.align_center, true)
    tfZeile(o + 1, "Daily", sD, pD, aD, aD1, dD)
    tfZeile(o + 2, "4h", s4, p4, a4, a41, d4)
    tfZeile(o + 3, "1h", s1, p1, a1h, a1h1, d1)
    tfZeile(o + 4, "15m", s15, p15, a15, a151, d15)
    tfZeile(o + 5, "5m", s5, p5, a5, a51, d5)

    vT = vaSt(vahT, valT)
    vW = vaSt(vahW, valW)
    lage(0, o + 6, "☰ VA Tag", vT)
    lage(2, o + 6, "☰ VA Woche", vW)
    lage(0, o + 7, "VWAP Tag", vwSt(vwT))
    lage(2, o + 7, "VWAP Woche", vwSt(vwW))
    lage(0, o + 8, "VWAP Monat", vwSt(vwM))
    zelle(2, o + 8, handel ? "◷ Zeit:  OK" : "◷ Zeit:  AUS", handel ? color.black : color.white, handel ? tLong : tShort, tGr, text.align_left)
    zelle(0, o + 9, "ⓘ  ADX:  ↑ stärker  ·  ↓ schwächer  ·  – konsolidiert (unter " + str.tostring(adxSw) + ")", color.new(color.white, 25), tKopf, size.small)

    // Setup-Banner (Chico 06.10. + 08.10.): VA-Lage + EMA-Cloud 5m/15m → eine klare Ansage
    emaDir = s5 == -1 and s15 == -1 ? -1 : s5 == 1 and s15 == 1 ? 1 : 0
    vaDir  = vT == 1 and vW == 1 ? 1 : vT == -1 and vW == -1 ? -1 : 0
    hoeher = (sD == emaDir or sD == 2) and (s4 == emaDir or s4 == 2)
    string bTitel = ""
    string bSub   = ""
    string bAns   = ""
    color  bFarbe = regelRot
    bool   bRot   = true
    if not handel
        bTitel := "⛔  KEINE TRADES"
        bSub   := "außerhalb Handelszeit"
        bAns   := "WARTEN"
    else if vaDir != 0 and emaDir != 0 and vaDir != emaDir
        bTitel := "⚠  SETUP-KONFLIKT"
        bSub   := "VA " + (vaDir == 1 ? "darüber" : "darunter") + " · 5m + 15m " + (emaDir == 1 ? "bullish" : "bearish")
        bAns   := "KEIN TRADE"
    else if emaDir != 0
        bTitel := hoeher ? "✔  SETUP KLAR" : "⚠  SETUP-KONFLIKT"
        bSub   := "5m + 15m " + (emaDir == 1 ? "bullish" : "bearish") + (hoeher ? " · Daily/4h passen" : " · Daily/4h dagegen")
        bAns   := emaDir == 1 ? "NUR LONGS" : "NUR SHORTS"
        bRot   := not (hoeher and emaDir == 1)
        bFarbe := bRot ? regelRot : color.new(#5a5a5a, 0)
    else if vaDir != 0
        bTitel := "⚠  MISCHVERHÄLTNIS"
        bSub   := "VA Tag + Woche " + (vaDir == 1 ? "darüber → keine Shorts" : "darunter → keine Longs")
        bAns   := vaDir == 1 ? "NUR LONG-BREAKS" : "NUR SHORT-BREAKS"
    else
        bTitel := "◆  MISCHVERHÄLTNIS"
        bSub   := "5m / 15m uneinig"
        bAns   := "NUR BREAKS"
        bRot   := false
        bFarbe := color.new(#3a3a3a, 0)
    zelle(0, o + 10, bTitel, color.white, bFarbe, grGross, text.align_left, true)
    zelle(0, o + 11, bSub, color.new(color.white, 15), bFarbe, tGr, text.align_left)
    zelle(0, o + 12, bAns, color.white, bRot ? #5e1c27 : #2b2b2b, grGross, text.align_center, true)

    // Checkliste
    zelle(0, o + 13, "✅  Long: Zone oben verlassen", color.white, tDunk, tGr, text.align_left)
    zelle(0, o + 14, "✅  Short: Pullback in Zone, dann unten raus", color.white, tDunk, tGr, text.align_left)
    zelle(0, o + 15, "✅  Pullback nur mit Trend", color.white, tDunk, tGr, text.align_left)

    // Live-Signal: letzter Zonen-Ausstieg (egal wo der Preis jetzt ist)
    int    bestJ  = scanBars + 1
    int    sDir   = 0
    bool   sBreak = false
    float  sSL    = na
    string sZone  = ""
    lb = math.min(scanBars, bar_index - 1)
    if zLo.size() > 0
        for zi = 0 to zLo.size() - 1
            lo = zLo.get(zi)
            hi = zHi.get(zi)
            for j = 0 to lb - 1
                if j >= bestJ
                    break
                inJ1 = close[j + 1] >= lo and close[j + 1] <= hi
                outJ = close[j] > hi or close[j] < lo
                // Ausstieg: vorher in der Zone und jetzt draußen – oder in einer Kerze durch die Zone gesprungen
                sprung = (close[j + 1] < lo and close[j] > hi) or (close[j + 1] > hi and close[j] < lo)
                if (inJ1 and outJ) or sprung
                    // woher kam der Preis?
                    int vonSeite = 0
                    if sprung
                        vonSeite := close[j + 1] < lo ? -1 : 1
                    else
                        for k = j + 1 to lb
                            if close[k] < lo
                                vonSeite := -1
                                break
                            if close[k] > hi
                                vonSeite := 1
                                break
                    d = close[j] > hi ? 1 : -1
                    if vonSeite != 0
                        bestJ  := j
                        sDir   := d
                        sBreak := vonSeite == -d
                        sSL    := d == 1 ? lo - slPuffer * syminfo.mintick : hi + slPuffer * syminfo.mintick
                        sZone  := zNm.get(zi)
                    break
    keyC = color.new(color.white, 30)
    if sDir != 0 and bestJ <= sigBars
        // Regeln: VA-Lage + Trend, Pullback nur in Trendrichtung
        // Chico 08.10.: 5m + 15m short → KEINE Longs (gilt immer), 5m + 15m long → keine Shorts
        vaOK   = vaDir == 1 ? sDir == 1 : vaDir == -1 ? sDir == -1 : true
        dirOK  = vaOK and (emaDir == 0 or sDir == emaDir)
        typOK  = sBreak or sDir == emaDir
        ok     = dirOK and typOK and handel
        ticks  = math.round(math.abs(close - sSL) / syminfo.mintick)
        tickV  = syminfo.pointvalue * syminfo.mintick
        proK   = ticks * tickV
        anz    = proK > 0 ? math.floor(riskUSD / proK) : 0
        grund  = not handel ? "außerhalb Handelszeit" : not dirOK ? "Richtung verboten" : not typOK ? "Pullback gegen Trend" : "alle Regeln erfüllt"
        kopfB  = ok ? cOK : regelRot
        kopfT  = ok ? color.black : color.white
        zelle(0, o + 16, (sDir == 1 ? "▲  LONG " : "▼  SHORT ") + (sBreak ? "BREAK" : "PULLBACK"), kopfT, kopfB, tGr, text.align_left, true)
        zelle(2, o + 16, ok ? "ERLAUBT" : "NICHT ERLAUBT", color.white, ok ? #2b2b2b : #5e1c27, size.small, text.align_center, true)
        zelle(0, o + 17, "Zone", keyC, tDunk, tGr, text.align_left)
        zelle(1, o + 17, sZone + " · vor " + str.tostring(bestJ) + " Bars", color.white, tDunk, tGr, text.align_left)
        zelle(0, o + 18, "Grund", keyC, tDunk, tGr, text.align_left)
        zelle(1, o + 18, grund, color.white, tDunk, tGr, text.align_left)
        zelle(0, o + 19, "SL", keyC, tDunk, tGr, text.align_left)
        zelle(1, o + 19, str.tostring(sSL, "#.##"), color.white, tDunk, tGr, text.align_left)
        zelle(0, o + 20, "Risiko", keyC, tDunk, tGr, text.align_left)
        zelle(1, o + 20, str.tostring(ticks) + " Ticks  ·  $" + str.tostring(proK, "#") + " / Kontrakt", color.white, tDunk, tGr, text.align_left)
        zelle(0, o + 21, "Limit", keyC, tDunk, tGr, text.align_left)
        zelle(1, o + 21, anz < 1 ? "SL zu weit für $" + str.tostring(riskUSD, "#") : "max. " + str.tostring(anz) + " Kontrakte bei $" + str.tostring(riskUSD, "#"), color.white, tDunk, tGr, text.align_left)
    else
        zelle(0, o + 16, "◇  KEIN SIGNAL", color.white, cNo, tGr, text.align_left, true)
        zelle(2, o + 16, "letzte " + str.tostring(sigBars) + " Bars", color.white, cNo, size.small)
        for r = o + 17 to o + 21
            leer(0, r)
            leer(1, r)

    // Volumen-Profil (was der Indikator selbst berechnet hat)
    if vpTab
        zelle(0, o + 22, "Profil T", keyC, tDunk, size.small, text.align_left)
        zelle(1, o + 22, vpAuto ? profTxt(pT_an, tPoc, tVah, tVal, tHvn, tVoll) : "Textblock", color.white, tDunk, size.small, text.align_left)
        zelle(0, o + 23, "Profil W", keyC, tDunk, size.small, text.align_left)
        zelle(1, o + 23, vpAuto ? profTxt(pW_an, wPoc, wVah, wVal, wHvn, wVoll) : "Textblock", color.white, tDunk, size.small, text.align_left)
        zelle(0, o + 24, "Profil M", keyC, tDunk, size.small, text.align_left)
        zelle(1, o + 24, vpAuto ? profTxt(pM_an, mPoc, mVah, mVal, mHvn, mVoll) : "Textblock", color.white, tDunk, size.small, text.align_left)
    else
        for r = o + 22 to o + 24
            leer(0, r)
            leer(1, r)

    zelle(0, o + 25, szText, color.white, szText == "" ? color.new(color.white, 100) : tDunk, tGr, text.align_left)
    zelle(0, o + 26, liveOn ? "LIVE · Faktor " + str.tostring(fLive, "#.####") + "  (Text " + str.tostring(fBase, "#.###") + ")  ·  DP-Level Δ " + str.tostring((fLive - fBase) / fBase * close, "#.#") + " P" : "", color.white, liveOn ? color.new(#5a5a5a, 0) : color.new(color.white, 100), tGr, text.align_left)

    if not gemerged
        if tAbst > 0
            for r = 0 to tAbst - 1
                table.merge_cells(tb, 0, r, 3, r)
        for r = o + 6 to o + 8
            table.merge_cells(tb, 0, r, 1, r)
            table.merge_cells(tb, 2, r, 3, r)
        for r = o + 9 to o + 15
            table.merge_cells(tb, 0, r, 3, r)
        table.merge_cells(tb, 0, o + 16, 1, o + 16)
        table.merge_cells(tb, 2, o + 16, 3, o + 16)
        for r = o + 17 to o + 24
            table.merge_cells(tb, 1, r, 3, r)
        for r = o + 25 to o + 26
            table.merge_cells(tb, 0, r, 3, r)
        gemerged := true
