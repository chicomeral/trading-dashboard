vW_c  = input.color(#ffffff, "", group = "VWAP", inline = "2")
vW_w  = input.int(1, "Dicke", minval = 1, maxval = 4, group = "VWAP", inline = "2")
vM_on = input.bool(false, "VWAP Monat", group = "VWAP", inline = "3")
vM_c  = input.color(#8c2f3c, "", group = "VWAP", inline = "3")
