//@version=6
// cMTrades – Daily OI Levels
// Textblock OI:      31270,C1 -Wall | 21,1k - 466 (strong)      (C = Call/Wall, P = Put/Support, DP = Doppelzone)
// Volumen-Levels:    NEU 09.10. – rechnet der Indikator selbst (wie FRVP): VAH / VAL / POC + HVN (Berge)
//                    Tag = Vortag 14:00–22:00 · Woche = Vorwoche Mo 00:00 – Fr 00:00 · Monat = Vormonat (alles DE-Zeit)
//                    Textblock bleibt als Notfall-Quelle („Volumen-Levels Quelle“ = Textblock)
// Tabelle: EMA-Cloud 20/50 je TF · ADX · Struktur (BOS) · Value Area T/W · VWAP T/W/M · Uhr (Handelszeit) · Setup-Banner · Signal
// Glow: Volumen-Levels und OI-Mittellinien mit einstellbarem Leucht-Effekt, OI-Zonen mit Verlauf (Mitte kräftig, Rand weich)
// Neu 08.10.: Orderblocks & Breakers (VEGAlgo, an/aus) · vertikale Zeitrahmen-Linien · Tabelle mit ADX + Marktstruktur (BOS)
indicator("cMTrades - Daily OI Levels", overlay = true, max_lines_count = 500, max_boxes_count = 500, max_labels_count = 150, max_bars_back = 5000)

// ── LIVE (Chico 08.10.): OI-Levels mit Live-Faktor NQ/QQQ verschieben, Volumen bleibt ──
liveOn  = input.bool(false, "LIVE aktiv – OI-Levels mit Live-Faktor", group = "LIVE", tooltip = "Strike = Level ÷ Faktor im Textblock (QQQ-Strikes sind ganze Zahlen) · neuer Preis = Strike × Live-Faktor. Live-Faktor = Mittel NQ/QQQ der letzten 15 Min, nur 15:30–22:00; außerhalb gilt der letzte Wert (Vormittag = Schluss gestern)")
fBase   = input.float(41.437, "Faktor im Textblock", step = 0.001, group = "LIVE")
qqqSym  = input.symbol("NASDAQ:QQQ", "QQQ-Symbol", group = "LIVE")
liveMin = input.float(2.0, "Levels erst verschieben ab (Punkte)", minval = 0.5, group = "LIVE")

// ── Textblöcke ─────────────────────────────────────────────
oiText  = input.text_area("31492,C2 -Wall | 11,5k - 3,8k\n31285,C3 -Wall | 4,5k - 3,6k\n31244,DP1 -Doppelzone | 21,1k - 23,1k (strong)\n31160,P2 -Support | 4,4k - 4,6k", "OI-Levels Textblock", group = "Textblöcke")
sonText = input.text_area("32321,C↑ -Wall | 8,2k - 26 (außerhalb Range)\n32114,C↑ -Wall | 7,9k - 15 (außerhalb Range)\n31906,C↑ -Wall | 5,9k - 390 (außerhalb Range)\n31699,C↑ -Wall | 7,9k - 767 (außerhalb Range)\n31673,EM↑ -Expected Move | ±275 P bis 09.10.\n31123,EM↓ -Expected Move | ±275 P bis 09.10.\n31078,DP↓ -Doppelzone | 8,9k - 10,7k (außerhalb Range)\n31036,DP↓ -Doppelzone | 4,4k - 6,2k (außerhalb Range)\n30663,P↓ -Support | 2,7k - 7,8k (außerhalb Range)\n30249,P↓ -Support | 1,5k - 33,7k (außerhalb Range)", "Sonderlevels Textblock (außerhalb Range, EM)", group = "Textblöcke")
volText = input.text_area("", "Volumen-Levels Textblock (nur wenn Quelle = Textblock)", group = "Textblöcke", tooltip = "Format wie früher: 31350,VAH T | Volumen Vortag  (T = Vortag, W = Vorwoche, M = Vormonat)")
szText  = input.text_area("", "Szenario (Claude, jeden Morgen)", group = "Textblöcke")
oiAlle  = oiText + "\n" + sonText

// ── Volumen-Profil (automatisch, wie FRVP) ─────────────────
gVP      = "Volumen-Profil · Allgemein"
vpQuelle = input.string("Automatisch", "Volumen-Levels Quelle", options = ["Automatisch", "Textblock"], group = gVP, tooltip = "Automatisch = der Indikator rechnet VAH / VAL / POC / HVN selbst aus dem Volumen (wie FRVP, Ticks pro Zeile). Textblock = alte Variante zum Einfügen")
vpWoEnde = input.string("Fr 00:00", "Woche endet (Start immer Mo 00:00)", options = ["Fr 00:00", "Fr 22:00", "Sa 00:00"], group = gVP, tooltip = "Fr 00:00 = Mo–Do · Fr 22:00 = inkl. Freitag bis Börsenschluss · Sa 00:00 = ganze Woche")
vpPreis  = input.bool(true, "Preis im Label", group = gVP, inline = "lb")
vpTab    = input.bool(true, "Profil-Werte in Tabelle", group = gVP, inline = "lb")

// Je Bereich: an/aus · Daten · Zeilengröße · Value Area % · HVN-Empfindlichkeit · VAH/VAL · POC · HVN (Farbe, Linie, Dicke)
hvnTip  = "HVN = Berge im Volumenprofil. Höhere Zahl = mehr und kleinere Berge (feiner). Niedrige Zahl = nur die großen Berge. Der POC-Berg selbst ist schon die POC-Linie"
datTip  = "Aus welchem Zeitrahmen das Volumen kommt. Kleiner = genauer (wie FRVP), braucht aber mehr Historie. Tag 1 · Woche 5 · Monat 30 passt für NQ"

gT      = "Volumen TAG · Vortag"
pT_an   = input.bool(true, "Tag an", group = gT, inline = "t0")
pT_ses  = input.session("1400-2200", "Session (DE)", group = gT, inline = "t0")
pT_tf   = input.timeframe("1", "Daten", group = gT, inline = "t1", tooltip = datTip)
pT_row  = input.int(7, "Ticks/Zeile", minval = 1, maxval = 200, group = gT, inline = "t1")
pT_va   = input.float(70, "Value Area %", minval = 50, maxval = 95, group = gT, inline = "t2")
pT_sen  = input.int(5, "HVN Empfindl.", minval = 1, maxval = 10, group = gT, inline = "t2", tooltip = hvnTip)
pT_max  = input.int(6, "max HVN", minval = 0, maxval = 15, group = gT, inline = "t2")
pT_sVA  = input.bool(true, "VAH/VAL", group = gT, inline = "t3")
pT_cVA  = input.color(#ffffff, "", group = gT, inline = "t3")
pT_lVA  = input.string("gestrichelt", "", options = ["durchgezogen", "gestrichelt", "gepunktet"], group = gT, inline = "t3")
pT_wVA  = input.int(1, "", minval = 1, maxval = 4, group = gT, inline = "t3")
pT_sPC  = input.bool(true, "POC     ", group = gT, inline = "t4")
pT_cPC  = input.color(#8c2f3c, "", group = gT, inline = "t4")
pT_lPC  = input.string("gestrichelt", "", options = ["durchgezogen", "gestrichelt", "gepunktet"], group = gT, inline = "t4")
pT_wPC  = input.int(2, "", minval = 1, maxval = 4, group = gT, inline = "t4")
pT_sHV  = input.bool(true, "HVN     ", group = gT, inline = "t5")
pT_cHV  = input.color(#1c1c1c, "", group = gT, inline = "t5")
pT_lHV  = input.string("gepunktet", "", options = ["durchgezogen", "gestrichelt", "gepunktet"], group = gT, inline = "t5")
pT_wHV  = input.int(1, "", minval = 1, maxval = 4, group = gT, inline = "t5")

gW      = "Volumen WOCHE · Vorwoche"
pW_an   = input.bool(true, "Woche an", group = gW, inline = "w0")
pW_tf   = input.timeframe("5", "Daten", group = gW, inline = "w1", tooltip = datTip)
pW_row  = input.int(7, "Ticks/Zeile", minval = 1, maxval = 400, group = gW, inline = "w1")
pW_va   = input.float(70, "Value Area %", minval = 50, maxval = 95, group = gW, inline = "w2")
pW_sen  = input.int(5, "HVN Empfindl.", minval = 1, maxval = 10, group = gW, inline = "w2", tooltip = hvnTip)
pW_max  = input.int(6, "max HVN", minval = 0, maxval = 15, group = gW, inline = "w2")
pW_sVA  = input.bool(true, "VAH/VAL", group = gW, inline = "w3")
pW_cVA  = input.color(#ffffffa6, "", group = gW, inline = "w3")
pW_lVA  = input.string("gestrichelt", "", options = ["durchgezogen", "gestrichelt", "gepunktet"], group = gW, inline = "w3")
pW_wVA  = input.int(1, "", minval = 1, maxval = 4, group = gW, inline = "w3")
pW_sPC  = input.bool(true, "POC     ", group = gW, inline = "w4")
pW_cPC  = input.color(#8c2f3c, "", group = gW, inline = "w4")
pW_lPC  = input.string("gestrichelt", "", options = ["durchgezogen", "gestrichelt", "gepunktet"], group = gW, inline = "w4")
pW_wPC  = input.int(2, "", minval = 1, maxval = 4, group = gW, inline = "w4")
pW_sHV  = input.bool(true, "HVN     ", group = gW, inline = "w5")
pW_cHV  = input.color(#3a3a3a, "", group = gW, inline = "w5")
pW_lHV  = input.string("gepunktet", "", options = ["durchgezogen", "gestrichelt", "gepunktet"], group = gW, inline = "w5")
pW_wHV  = input.int(1, "", minval = 1, maxval = 4, group = gW, inline = "w5")

gM      = "Volumen MONAT · Vormonat"
pM_an   = input.bool(true, "Monat an", group = gM, inline = "m0")
pM_tf   = input.timeframe("30", "Daten", group = gM, inline = "m1", tooltip = datTip)
pM_row  = input.int(7, "Ticks/Zeile", minval = 1, maxval = 800, group = gM, inline = "m1")
pM_va   = input.float(70, "Value Area %", minval = 50, maxval = 95, group = gM, inline = "m2")
pM_sen  = input.int(5, "HVN Empfindl.", minval = 1, maxval = 10, group = gM, inline = "m2", tooltip = hvnTip)
pM_max  = input.int(6, "max HVN", minval = 0, maxval = 15, group = gM, inline = "m2")
pM_sVA  = input.bool(true, "VAH/VAL", group = gM, inline = "m3")
pM_cVA  = input.color(#c9c9c6, "", group = gM, inline = "m3")
pM_lVA  = input.string("gestrichelt", "", options = ["durchgezogen", "gestrichelt", "gepunktet"], group = gM, inline = "m3")
pM_wVA  = input.int(1, "", minval = 1, maxval = 4, group = gM, inline = "m3")
pM_sPC  = input.bool(true, "POC     ", group = gM, inline = "m4")
pM_cPC  = input.color(#8c2f3c, "", group = gM, inline = "m4")
pM_lPC  = input.string("gestrichelt", "", options = ["durchgezogen", "gestrichelt", "gepunktet"], group = gM, inline = "m4")
pM_wPC  = input.int(2, "", minval = 1, maxval = 4, group = gM, inline = "m4")
pM_sHV  = input.bool(true, "HVN     ", group = gM, inline = "m5")
pM_cHV  = input.color(#6b6e76, "", group = gM, inline = "m5")
pM_lHV  = input.string("gepunktet", "", options = ["durchgezogen", "gestrichelt", "gepunktet"], group = gM, inline = "m5")
pM_wHV  = input.int(1, "", minval = 1, maxval = 4, group = gM, inline = "m5")

// ── Glow / Verlauf ─────────────────────────────────────────
gG      = "Glow / Verlauf"
glowVol = input.bool(true, "Glow Volumen-Levels", group = gG, inline = "g0")
glowOI  = input.bool(true, "Glow OI-Mittellinien", group = gG, inline = "g0")
glowLag = input.int(3, "Glow Stufen", minval = 1, maxval = 6, group = gG, inline = "g1", tooltip = "Anzahl Leucht-Schichten um die Linie (mehr = weicher Verlauf)")
glowBr  = input.int(3, "Breite je Stufe (px)", minval = 1, maxval = 10, group = gG, inline = "g1")
glowTr  = input.int(82, "Glow Transparenz (innen)", minval = 0, maxval = 99, group = gG, tooltip = "Niedriger = kräftigeres Leuchten. Außen wird es automatisch weicher")
glowEig = input.bool(false, "Eigene Glow-Farbe", group = gG, inline = "gf", tooltip = "Aus = jede Linie leuchtet in ihrer eigenen Farbe")
glowCol = input.color(#ffffff, "", group = gG, inline = "gf")
zVerl   = input.bool(true, "OI-Zonen mit Verlauf (Mitte kräftig, Rand weich)", group = gG, inline = "zv")
zVerlN  = input.int(4, "Stufen", minval = 2, maxval = 8, group = gG, inline = "zv")

// ── Orderblocks & Breakers (VEGAlgo, MPL 2.0) – an/aus ─────
obOn       = input.bool(false, "Orderblocks & Breakers anzeigen", group = "Orderblocks & Breakers")
obSwing    = input.int(5, "Swing-Länge (Kerzen)", minval = 1, maxval = 50, group = "Orderblocks & Breakers", tooltip = "Kerzen links/rechts für Swing-High/Low")
obRecentOn = input.bool(true, "Nur neueste zeigen", group = "Orderblocks & Breakers", inline = "r")
obRecent   = input.int(10, "Anzahl", minval = 1, maxval = 50, group = "Orderblocks & Breakers", inline = "r")
obShowOB   = input.bool(true, "Orderblocks", group = "Orderblocks & Breakers", inline = "s")
obShowBr   = input.bool(true, "Breaker", group = "Orderblocks & Breakers", inline = "s")
obChop     = input.bool(true, "Chop-Kontrolle", group = "Orderblocks & Breakers", tooltip = "Breaker entfernen, die mehrfach durchschlossen werden")
cOBbullF   = input.color(color.new(color.aqua, 80), "Bullish OB (Füllung | Rahmen)", group = "Orderblocks & Breakers", inline = "a")
cOBbullR   = input.color(color.aqua, "", group = "Orderblocks & Breakers", inline = "a")
cOBbearF   = input.color(color.new(color.red, 80), "Bearish OB (Füllung | Rahmen)", group = "Orderblocks & Breakers", inline = "b")
cOBbearR   = input.color(color.red, "", group = "Orderblocks & Breakers", inline = "b")
cBRbullF   = input.color(color.new(color.blue, 80), "Bullish Breaker (Füllung | Rahmen)", group = "Orderblocks & Breakers", inline = "c", tooltip = "OB nach oben durchbrochen")
cBRbullR   = input.color(color.blue, "", group = "Orderblocks & Breakers", inline = "c")
cBRbearF   = input.color(color.new(color.maroon, 80), "Bearish Breaker (Füllung | Rahmen)", group = "Orderblocks & Breakers", inline = "d", tooltip = "OB nach unten durchbrochen")
cBRbearR   = input.color(color.maroon, "", group = "Orderblocks & Breakers", inline = "d")

// ── Vertikale Linien (Zeitrahmen-Trenner) ──────────────────
vlOn   = input.bool(true, "Vertikale Linien an", group = "Vertikale Linien")
vlTf   = input.timeframe("60", "Zeitrahmen", group = "Vertikale Linien", tooltip = "Eine Linie bei jedem Start dieses Zeitrahmens (z. B. 60 = jede volle Stunde). Muss gleich oder größer als der Chart-Zeitrahmen sein")
vlCol  = input.color(#000000, "Farbe", group = "Vertikale Linien", inline = "v")
vlBr   = input.int(1, "Dicke", minval = 1, maxval = 3, group = "Vertikale Linien", inline = "v")
vlStil = input.string("gepunktet", "Linienart", options = ["durchgezogen", "gestrichelt", "gepunktet"], group = "Vertikale Linien")
vlAnz  = input.int(100, "Anzahl Linien (Verlauf)", minval = 1, maxval = 300, group = "Vertikale Linien")

// ── Farben (Konzept: Dunkelrot · Schwarz · Weiß · Grau) ──────
cCall  = input.color(#3a3a3a, "Call / Wall", group = "Farben", inline = "z")
cPut   = input.color(#ffffff, "Put / Support", group = "Farben", inline = "z")
cDP    = input.color(#ffffff, "Doppelzone + stärkste Zone", group = "Farben", inline = "z")
cMitte = input.color(#2b2b2b, "Mittellinie", group = "Farben", inline = "m")
cText  = input.color(#1c1c1c, "Text OI", group = "Farben", inline = "m")
cBoxT  = input.color(#5f6268, "VA Vortag (Säule/Hintergrund)", group = "Farben", inline = "b")
cBoxW  = input.color(#3a3a3a, "VA Woche (Säule/Hintergrund)", group = "Farben", inline = "b")
tLong  = input.color(#ffffff, "Tabelle Long", group = "Farben", inline = "t")
tShort = input.color(#9e2a3a, "Tabelle Short", group = "Farben", inline = "t")
tNeut  = input.color(#6b6e76, "Tabelle Neutral", group = "Farben", inline = "t")
tTxt   = input.color(#2a2e39, "Tabelle Schrift", group = "Farben", inline = "t")
regelRot = input.color(#8c2f3c, "Regelbox Warnung", group = "Farben")

// ── Risiko / Live-Signal (Chico 08.10.) ─────────────────────
riskUSD  = input.float(100, "Risiko pro Trade ($)", minval = 10, group = "Risiko")
slPuffer = input.int(4, "SL-Puffer hinter Zone (Ticks)", minval = 0, group = "Risiko")
sigBars  = input.int(30, "Signal gültig (Bars nach Zonen-Ausstieg)", minval = 1, maxval = 300, group = "Risiko")
scanBars = input.int(240, "Rückblick Zonen-Scan (Bars)", minval = 20, maxval = 1000, group = "Risiko")
cOK      = input.color(#ffffff, "Signal erlaubt", group = "Risiko", inline = "sg")
cNo      = input.color(#5a5a5a, "Signal nicht erlaubt", group = "Risiko", inline = "sg")

// ── OI-Zonen ───────────────────────────────────────────────
zoneTicks = input.int(45, "Zonenbreite (Ticks)", minval = 1, group = "OI-Zonen")
zoneTr    = input.int(72, "Zonen-Transparenz (Call/Put)", minval = 0, maxval = 100, group = "OI-Zonen")
dpTr      = input.int(55, "Transparenz Doppelzone + stärkste Zone", minval = 0, maxval = 100, group = "OI-Zonen", tooltip = "Höher = schwächer/heller")
mitteTr   = input.int(55, "Mittellinie-Transparenz", minval = 0, maxval = 100, group = "OI-Zonen", inline = "m")
mitteW    = input.int(1, "Breite", minval = 1, maxval = 4, group = "OI-Zonen", inline = "m")
oiInfo    = input.bool(true, "OI-Werte im Label", group = "OI-Zonen")
emOn      = input.bool(true, "Expected Move (EM↑/EM↓)", group = "OI-Zonen", inline = "em")
cEM       = input.color(#1c1c1c, "", group = "OI-Zonen", inline = "em")

// ── Value Area Säule / Hintergrund ─────────────────────────
vaBox   = input.string("Säule rechts", "Value Area anzeigen als", options = ["Säule rechts", "Hintergrund", "aus"], group = "Value Area Säule", tooltip = "Säule rechts = schmale senkrechte Säule VAL–VAH neben der letzten Kerze (Chart bleibt frei)")
vaSAbst = input.int(15, "Säule Abstand (Bars)", minval = 1, maxval = 200, group = "Value Area Säule", inline = "sa")
