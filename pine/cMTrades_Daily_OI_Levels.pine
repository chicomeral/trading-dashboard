boxTr   = input.int(80, "Box-Transparenz (Hintergrund)", minval = 0, maxval = 100, group = "Value Area Säule")

// ── VWAP (Kurven, Farbe + Dicke je Linie) ───────────────────
vwStart = input.string("14:00", "Daily VWAP Start (DE)", options = ["14:00", "00:00"], group = "VWAP")
