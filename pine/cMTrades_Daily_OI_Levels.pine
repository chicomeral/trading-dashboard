// ── Allgemein ──────────────────────────────────────────────
oiAbst  = input.int(8, "Label-Abstand OI (Bars rechts)", group = "Allgemein")
zeichAb = input.string("Heute", "Zonen/Linien zeichnen ab", options = ["Heute", "Ganzer Chart"], group = "Allgemein", tooltip = "Heute = ab 00:00 nach rechts. Der Chart bleibt links frei anklickbar (Zurücksetzen, eigene Zeichnungen)")
txtGr   = input.string(size.small, "Textgröße", options = [size.tiny, size.small, size.normal], group = "Allgemein")

// ── Trend-Tabelle ──────────────────────────────────────────
tShow = input.bool(true, "Trend-Tabelle", group = "Trend-Tabelle")
tPos  = input.string(position.top_right, "Position", options = [position.top_left, position.top_center, position.top_right, position.middle_right, position.bottom_left, position.bottom_center, position.bottom_right], group = "Trend-Tabelle")
tAbst = input.int(2, "Abstand nach unten (Leerzeilen 0–3)", minval = 0, maxval = 3, group = "Trend-Tabelle")
